#!/usr/bin/env bash
# planhop pre-commit hook
#
# The fast lane of DEFINITION_OF_DONE.md, on the working tree:
#
#   1. gitleaks on the staged diff (secrets)
#   2. `pnpm run verify` - lint + typecheck + vitest + pnpm audit
#
# The pre-push hook runs the full set against a clean export of each
# pushed commit (bin/preflight.sh).
#
# To install:
#   bin/setup-git-hooks.sh
#
# To bypass in a real emergency:
#   git commit --no-verify   # be prepared to justify it

set -euo pipefail

RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
DIM='\033[2m'
RST='\033[0m'

fail() {
  echo -e "${RED}pre-commit: FAIL${RST} - $1" >&2
  exit 1
}

warn() {
  echo -e "${YEL}pre-commit: warn${RST} - $1" >&2
}

ok() {
  echo -e "${GRN}pre-commit: ok${RST} - $1"
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ----------------------------------------------------------------
# 1. Secrets scan
# ----------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner 2>&1; then
    fail "gitleaks found potential secrets in the staged diff. Redact and re-stage."
  fi
  ok "gitleaks: no secrets in staged diff"
else
  warn "gitleaks not installed - skipping the staged secrets scan (pre-push still runs it)."
fi

# ----------------------------------------------------------------
# 2. Verify. Capped where systemd is available: an uncapped vitest run
#    has been OOM-killed on this host.
# ----------------------------------------------------------------
VERIFY=(pnpm run verify)
if command -v systemd-run >/dev/null 2>&1 && systemctl --user is-system-running >/dev/null 2>&1; then
  VERIFY=(systemd-run --user --scope --quiet -p MemoryMax=4G "${VERIFY[@]}")
fi

echo -e "${DIM}running: ${VERIFY[*]}${RST}"
if ! "${VERIFY[@]}"; then
  fail "verify failed. Read the output above, fix the errors, and re-commit."
fi
ok "verify: lint + typecheck + tests + audit green"

echo -e "${GRN}pre-commit: all fast-lane gates passed.${RST}"
